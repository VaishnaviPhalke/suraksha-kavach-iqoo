<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Disallow cloud backup for air-gapped security -->
        <exclude path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Disallow unencrypted device transfer -->
        <exclude path="." />
    </device-transfer>
</data-extraction-rules>
